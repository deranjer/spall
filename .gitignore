# Rust build outputs and per-run artifacts/worktrees.
/target/
**/target/
/.local/
**/.local/

# Local MCP / tool config (may contain secrets)
.codex/

# Packaged builds
/dist/

# Raw evidence policy: summaries (*.md) are tracked; raw run output is not.
# Already-tracked files stay tracked until removed deliberately.
/artifacts/
artifacts/
docs/reports/**/*.jsonl
docs/reports/**/*.log

# Raw ENG-103 grid-solver evidence (solver removed in ENG-169); kept on disk and in history only.
docs/reports/ENG-103-evidence/

# Client bundle staged by the release workflow (build output, not source).
/docker/client/*
!/docker/client/README.md

# Python bytecode caches.
__pycache__/
